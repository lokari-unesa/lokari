# ============================================================
# CONTOH konfigurasi frontend — salin sebagai `frontend/.env` bila perlu
#
#   cp frontend/.env.example frontend/.env
#
# Tidak berisi rahasia. Nilai di bawah = default yang sudah dipakai
# vite.config.ts, jadi file ini biasanya TIDAK perlu dibuat.
# Dibaca saat `npm run dev` manual (VITE_* & BACKEND_URL).
# ============================================================

# Port dev server Vite/SvelteKit
VITE_PORT=5180

# Target proxy `/api` saat dev manual (backend Golang)
# Default tanpa file ini: http://localhost:5181
BACKEND_URL=http://localhost:5181

# ============================================================
# Konfigurasi Vercel — set via dashboard, bukan file ini.
# Saat deploy, BACKEND_URL di atas wajib di-override ke URL publik
# backend Go (dipakai hooks.server.ts untuk meneruskan /api/*).
# ============================================================

# API key OpenRouteService (Wajib untuk pencarian rute aman)
# Dapatkan gratis di: https://openrouteservice.org/
# (server-only, dibaca di src/routes/api/route/+server.ts)
ORS_API_KEY=

# --- WEB PUSH NOTIFICATION (opsional) ---
# VAPID PUBLIC key — HARUS sama dengan VAPID_PUBLIC_KEY di backend/.env
# (generate: docker compose exec backend go run scripts/vapid.go)
# Nilai ini dibaca client browser (PUBLIC_* → statis saat build).
PUBLIC_VAPID_KEY=
