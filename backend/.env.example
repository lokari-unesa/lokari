# ============================================================
# CONTOH konfigurasi backend — salin sebagai `backend/.env`
#
#   cp backend/.env.example backend/.env   # lalu isi nilai asli
#
# `backend/.env` TIDAK di-commit (ada di .gitignore). Jangan pernah
# menaruh key asli di file contoh ini.
# ============================================================

# Port HTTP server Fiber
PORT=5181

# Daftar origin frontend yang diizinkan CORS (comma-separated).
# Default bila tidak diset: http://localhost:5180,http://localhost:5173
# Untuk produksi, set ke domain frontend, mis. https://lokari.vercel.app
CORS_ORIGINS=http://localhost:5180,http://localhost:5173

# Jalankan manual (luar Docker) — host port 5433 (docker) atau 5432 (native):
DATABASE_URL=postgresql://postgres:root@localhost:5433/lokari_db?sslmode=disable
# Saat berjalan DI DALAM docker-compose, nilai ini di-override compose
# ke `postgresql://postgres:root@db:5432/lokari_db?sslmode=disable`
# (host "db" = nama service, port internal 5432).

# --- KONFIGURASI AI (TEXT SUMMARIZER: alert & berita) ---
# Semua provider OpenAI-compatible didukung (OpenRouter, Groq, DeepSeek, ...)
AI_API_KEY=sk-xxxx
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free

# --- KONFIGURASI AI (VECTOR EMBEDDINGS: semantic search) ---
# Cohere embed-multilingual-v3.0 → vektor 1024 dimensi
COHERE_API_KEY=cohere_xxxx