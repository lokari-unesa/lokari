# ============================================================
# CONTOH env untuk docker-compose — salin sebagai `.env` di root
#
# Isi file ini HANYA variabel interpolasi compose (port & kredensial DB).
# TIDAK menampung secret API — secret backend tinggal di `backend/.env`
# (lihat `backend/.env.example`), secret frontend di `frontend/.env`
# (lihat `frontend/.env.example`).
#
# Semua variabel punya default inline di docker-compose.yaml (`:-`),
# jadi file ini opsional — buat hanya bila ingin mengubah nilai bawaan.
# ============================================================

# Port yang di-map ke host
FRONTEND_PORT=5180
BACKEND_PORT=5181
# Host port PostgreSQL (container selalu di 5432)
POSTGRES_PORT=5433

# Kredensial database (dipakai service db untuk inisialisasi)
POSTGRES_USER=postgres
# Wajib sama dengan password di backend/.env agar DSN konsisten
POSTGRES_PASSWORD=root
POSTGRES_DB=lokari_db
